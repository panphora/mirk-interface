{
  "name": "mirkui",
  "version": "1.0.0",
  "description": "A form-focused HTML/CSS UI kit. Fourteen components in plain Tailwind classes and one tiny shared script. No build step, no React, no web components.",
  "type": "module",
  "keywords": [
    "ui-kit",
    "tailwind",
    "tailwindcss",
    "form-components",
    "html-css",
    "pixel-font",
    "departure-mono",
    "no-build",
    "buildless",
    "design-system"
  ],
  "author": "David Miranda",
  "license": "MIT",
  "homepage": "https://github.com/davidmiranda/mirk-ui-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmiranda/mirk-ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/davidmiranda/mirk-ui-kit/issues"
  },
  "main": "mirk.js",
  "files": [
    "mirk.js",
    "mirk.css",
    "fonts/DepartureMono-1.500/DepartureMono-Regular.woff2",
    "fonts/DepartureMono-1.500/LICENSE",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:css": "tailwindcss -i mirk-input.css -o mirk.css --minify",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0"
  }
}
