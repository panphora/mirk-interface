{
  "name": "mirk-interface",
  "version": "2.2.0",
  "description": "A form-focused HTML/CSS UI kit. Fourteen components as semantic BEM classes in one hand-written CSS file plus one tiny delegated script. No build step, no React, no web components. Tailwind optional.",
  "type": "module",
  "keywords": [
    "ui-kit",
    "css",
    "bem",
    "semantic-classes",
    "form-components",
    "html-css",
    "pixel-font",
    "departure-mono",
    "no-build",
    "buildless",
    "tailwind",
    "design-system"
  ],
  "author": "David Miranda",
  "license": "MIT",
  "homepage": "https://github.com/panphora/mirk-ui-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panphora/mirk-ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/panphora/mirk-ui-kit/issues"
  },
  "main": "mirk.js",
  "style": "mirk.css",
  "exports": {
    ".": "./mirk.js",
    "./mirk.css": "./mirk.css"
  },
  "files": [
    "mirk.js",
    "mirk.css",
    "fonts/DepartureMono-1.500/DepartureMono-Regular.woff2",
    "fonts/DepartureMono-1.500/LICENSE",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "mkdir -p dist && cp mirk.css mirk.js dist/",
    "dev": "http-server -p 7382 -c-1 -o"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
